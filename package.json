{
  "name": "@jxtools/visualgit",
  "version": "1.5.11",
  "description": "Terminal-style git diff viewer with AI-powered explanations",
  "type": "module",
  "bin": {
    "visualgit": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "dist/",
    "dist-server/"
  ],
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:frontend": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "git",
    "diff",
    "viewer",
    "ai",
    "terminal"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/juancruzrossi/visualgit"
  },
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "detect-port": "^2.1.0",
    "express": "^5.2.1",
    "lucide-react": "^0.564.0",
    "open": "^11.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "simple-git": "^3.33.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
